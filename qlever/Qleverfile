# Qleverfile for mbox-rdf
# Use with qlever: https://github.com/ad-freiburg/qlever-control

[data]
NAME             = mbox
DESCRIPTION      = Thunderbird mbox archive converted to RDF N-Quads
VERSION          = $$(date +"%d.%m.%Y")
TEXT_DESCRIPTION = All literals, search with [ ql:contains-word "..."; ql:contains-entity ?literal ]
FORMAT           = nq

[index]
INPUT_FILES     = *.nq.gz
CAT_INPUT_FILES = gzip -dc ${INPUT_FILES}
SETTINGS_JSON   = { "num-triples-per-batch": 1000000 }
PARSER_BUFFER_SIZE = 100M
TEXT_INDEX      = from_literals

[server]
PORT               = 7029
ACCESS_TOKEN       = mbox_access_token
MEMORY_FOR_QUERIES = 5G
PERSIST_UPDATES    = true

[runtime]
SYSTEM = native

[ui]
UI_CONFIG = default
